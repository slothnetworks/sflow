load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

go_library(
    name = "portmirror_lib",
    srcs = [
        "frame.go",
        "iface.go",
        "portmirror.go",
    ],
    importpath = "github.com/monogon-dev/netmeta/cmd/portmirror",
    visibility = ["//visibility:private"],
    deps = [
        "@com_github_gopacket_gopacket//:gopacket",
        "@com_github_gopacket_gopacket//afpacket",
        "@com_github_gopacket_gopacket//layers",
        "@com_github_netsampler_goflow2//format",
        "@com_github_netsampler_goflow2//format/protobuf",
        "@com_github_netsampler_goflow2//pb",
        "@com_github_netsampler_goflow2//transport",
        "@com_github_netsampler_goflow2//transport/kafka",
        "@com_github_sirupsen_logrus//:logrus",
        "@com_github_vishvananda_netlink//:netlink",
    ],
)

go_binary(
    name = "portmirror",
    embed = [":portmirror_lib"],
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "portmirror_tar",
    srcs = [":portmirror"],
)

oci_image(
    name = "portmirror_image",
    base = "@distroless_base",
    entrypoint = ["/portmirror"],
    tars = [":portmirror_tar"],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "portmirror_load",
    image = ":portmirror_image",
    repo_tags = ["github.com/monogon-dev/netmeta/portmirror:latest"],
    visibility = ["//visibility:public"],
)
