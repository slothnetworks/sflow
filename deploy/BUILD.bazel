load("@rules_multirun//:defs.bzl", "multirun")

# Use //deploy:all_files for accessing all relevant files.
filegroup(
    name = "all_files",
    srcs = glob(["**/*"]) + [
        "//cue.mod",
        "//deploy/single-node:all_files",
    ],
    visibility = ["//visibility:public"],
)

multirun(
    name = "oci_load",
    commands = [
        "//cmd/portmirror:portmirror_load",
        "//cmd/reconciler:reconciler_load",
        "//cmd/risinfo:risinfo_load",
    ],
    jobs = 0,
)
