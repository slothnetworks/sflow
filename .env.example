# NetMeta configuration. Copy to .env and fill in the passwords:
#   cp .env.example .env
# Generate secrets with e.g. `openssl rand -hex 24`.

# --- ClickHouse -------------------------------------------------------------
# Admin user. Also used by migrate, geoip and ClickHouse's own dictionary sources.
# External Grafanas can use it over plain HTTP on CLICKHOUSE_HTTP_PORT.
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=
# Read-only user for the bundled Grafana.
CLICKHOUSE_GRAFANA_PASSWORD=
# ClickHouse HTTP interface, published on all interfaces (plain HTTP).
CLICKHOUSE_HTTP_PORT=15003
# Days of flows to keep in flows_raw (applied by migrate on every start).
RETENTION_DAYS=7

# --- Kafka ------------------------------------------------------------------
# Buffer between goflow2 and ClickHouse (bytes per partition; the topic has one partition).
KAFKA_RETENTION_BYTES=1000000000

# --- Collector (goflow2, host network) --------------------------------------
NETFLOW_PORT=2055
NETFLOW_LEGACY_PORT=2056
SFLOW_PORT=6343

# --- Grafana ----------------------------------------------------------------
GRAFANA_HTTP_PORT=15001
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SECRET_KEY=
# Role for users who sign in through OAuth: Viewer, Editor or Admin.
GRAFANA_DEFAULT_ROLE=Viewer
# Optional Google sign-in. Enabled when GRAFANA_GOOGLE_CLIENT_ID is set.
# The OAuth redirect URL is <root URL>/login/google (see PUBLIC_HOSTNAME below).
GRAFANA_GOOGLE_CLIENT_ID=
GRAFANA_GOOGLE_CLIENT_SECRET=
# Comma- or space-separated list of allowed e-mail domains (empty allows any Google account).
GRAFANA_GOOGLE_ALLOWED_DOMAINS=

# Hostname users type into the browser. Used for Grafana's default root URL and the TLS
# certificate.
PUBLIC_HOSTNAME=localhost
# The URL users reach Grafana at (OAuth redirects, links). Empty means
# http://PUBLIC_HOSTNAME:GRAFANA_HTTP_PORT/. With TLS: https://PUBLIC_HOSTNAME:GRAFANA_HTTPS_PORT/
GRAFANA_ROOT_URL=
# true when users reach Grafana over HTTPS only (TLS profile). Browsers drop secure cookies on
# plain HTTP, so leave it false while anyone still signs in on GRAFANA_HTTP_PORT.
GRAFANA_COOKIE_SECURE=false

# --- TLS (optional Caddy reverse proxy in front of Grafana) -----------------
# COMPOSE_PROFILES=tls starts Caddy (same as `docker compose --profile tls up -d`).
# Also set GRAFANA_ROOT_URL and GRAFANA_COOKIE_SECURE=true above.
COMPOSE_PROFILES=
GRAFANA_HTTPS_PORT=15002
# internal: certificate from Caddy's own local CA (self-signed, like the old deployment).
# acme:     Let's Encrypt. Only works when Caddy can answer the challenge on public :80 or :443,
#           i.e. GRAFANA_HTTPS_PORT=443 (or publish :80); see compose.yaml.
TLS_MODE=internal
ACME_EMAIL=

# --- Optional ASN / country enrichment (geoip loader) -----------------------
# NetMeta itself contacts no external service. Leave GEOIP_PROVIDERS empty and flows keep the
# AS numbers the exporter sends, with no country. To enrich, list one or more providers
# (comma-separated, later ones fill gaps left by earlier ones):
#   maxmind     MaxMind GeoLite2/GeoIP2 downloads. Free account and license key:
#               https://www.maxmind.com/en/geolite2/signup  (Account > Manage license keys)
#   ipinfo      IPinfo Lite database. Free token: https://ipinfo.io/signup
#   files       .mmdb files you place in config/geoip/
#   routeviews  ASN prefixes from the public RouteViews RIB dumps (no key; downloads ~100 MB)
GEOIP_PROVIDERS=
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_EDITIONS=GeoLite2-ASN,GeoLite2-Country
IPINFO_TOKEN=
# How often the loader refreshes its sources.
GEOIP_REFRESH=24h
# Optional: debug logging, and mirrors for the routeviews provider (empty = upstream defaults).
GEOIP_LOG_LEVEL=
ROUTEVIEWS_RIB_URL=
ROUTEVIEWS_ASNAMES_URL=

# --- Images -----------------------------------------------------------------
NETMETA_IMAGE_TAG=latest
