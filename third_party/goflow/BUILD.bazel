load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

pkg_tar(
    name = "goflow_tar",
    srcs = ["@com_github_netsampler_goflow2//cmd/goflow2"],
)

oci_image(
    name = "goflow_image",
    base = "@distroless_base",
    entrypoint = ["/goflow"],
    tars = [":goflow_tar"],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "goflow_load",
    image = ":goflow_image",
    repo_tags = ["github.com/monogon-dev/netmeta/goflow:latest"],
    visibility = ["//visibility:public"],
)
