bazel_dep(name = "gazelle")
single_version_override(
    module_name = "gazelle",
    patch_strip = 1,
    patches = [
        # Snatched from monogon-dev/monogon to support patches to
        # goflow for adding flowdirection.
        "//third_party/gazelle:add-prepatching.patch",
    ],
    version = "0.40.0",
)

bazel_dep(name = "rules_go")
single_version_override(
    module_name = "rules_go",
    patch_strip = 1,
    patches = [
        # Kick out cgo support from stdlib as the zig toolchain
        # doesn't like darwin right now.
        "//third_party/rules_go:disable-cgo.patch",
        "//third_party/rules_go:rules_go_absolute_embedsrc.patch",
    ],
    version = "0.50.1",
)

bazel_dep(name = "rules_oci", version = "2.0.1")
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "aspect_bazel_lib", version = "2.9.0")
bazel_dep(name = "hermetic_cc_toolchain", version = "3.1.0")
bazel_dep(name = "toolchains_protoc", version = "0.3.3")
bazel_dep(name = "rules_multirun", version = "0.9.0")
bazel_dep(name = "buildifier_prebuilt", version = "8.0.1")

toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_musl",
    "@zig_sdk//toolchain:linux_arm64_musl",
    "@zig_sdk//toolchain:windows_amd64",
    "@zig_sdk//toolchain:windows_arm64",
    "@zig_sdk//toolchain:darwin_amd64",
    "@zig_sdk//toolchain:darwin_arm64",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.23.1")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_clickhouse_clickhouse_go_v2",
    "com_github_emicklei_proto",
    "com_github_gopacket_gopacket",
    "com_github_huandu_go_sqlbuilder",
    "com_github_netsampler_goflow2",
    "com_github_netsampler_goflow2_v2",
    "com_github_osrg_gobgp",
    "com_github_pressly_goose_v3",
    "com_github_sirupsen_logrus",
    "com_github_vishvananda_netlink",
    "io_k8s_klog_v2",
    "org_cuelang_go",
)

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_base",
    digest = "sha256:7a4bffcb07307d97aa731b50cb6ab22a68a8314426f4e4428335939b5b1943a5",
    image = "gcr.io/distroless/base",
    platforms = [
        "linux/amd64",
        "linux/arm/v7",
        "linux/arm64/v8",
        "linux/ppc64le",
        "linux/s390x",
    ],
)
oci.pull(
    name = "grafana",
    digest = "sha256:2a73ae33c9f0c51af6eced2ef185d5d3682b4c378c4fdd6941a14e8ea4a3e95b",
    image = "index.docker.io/grafana/grafana",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
        "linux/arm/v7",
    ],
)
use_repo(
    oci,
    "distroless_base",
    "distroless_base_linux_amd64",
    "distroless_base_linux_arm64_v8",
    "distroless_base_linux_arm_v7",
    "distroless_base_linux_ppc64le",
    "distroless_base_linux_s390x",
    "grafana",
    "grafana_linux_amd64",
    "grafana_linux_arm64_v8",
    "grafana_linux_arm_v7",
)

grafana_plugin = use_repo_rule("//third_party/grafana:defs.bzl", "grafana_plugin")

grafana_plugin(
    name = "netsage-sankey-panel",
    plugin_name = "netsage-sankey-panel",
    version = "1.1.3",
)

grafana_plugin(
    name = "grafana-clickhouse-datasource",
    plugin_name = "grafana-clickhouse-datasource",
    version = "4.5.0",
)

grafana = use_repo_rule("//third_party/grafana:defs.bzl", "grafana")

grafana(
    name = "grafana_bin",
)
